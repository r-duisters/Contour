{
  "name": "contour",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "prisma": {
    "schema": "apps/web/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "npm run dev --workspace @contour/web",
    "build": "npm run build --workspace @contour/web",
    "start": "npm run start --workspace @contour/web --",
    "lint": "fail=0; for w in $(npm query .workspace --json | node -e \"const w=JSON.parse(require('fs').readFileSync(0));process.stdout.write(w.map(x=>x.name).join(' '))\"); do npm run lint --workspace $w --if-present || fail=1; done; exit $fail",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web && tsc --noEmit -p apps/mobile",
    "android:sync": "npx cap sync android",
    "android:build": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.1",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "jose": "^6.2.9",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.33.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
