<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The adaptive icon's background layer, which is what a launcher's mask is
      cut from — so this colour is the whole tile, in whatever shape the
      launcher prefers.

      It was the app's ground for a few builds, with the disc in the foreground,
      so that the mark stayed a circle under any mask. On One UI that put dark
      corners around the blue and the tile read worse for it. Filled blue is the
      call; the shape belongs to the launcher.
    -->
    <color name="ic_launcher_background">@color/contour_blue</color>
</resources>
