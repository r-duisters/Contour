<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
          This is the theme the activity runs under once launched, so this is
          the background Android substitutes for the recents card now that the
          card is no longer a photograph of the window. Without it the card is
          a flat rectangle.

          It sits behind an opaque WebView, so it costs nothing while the app
          is actually on screen.
        -->
        <item name="android:windowBackground">@drawable/contour_splash</item>
        <!--
          What the recents card is actually filled with. Disabling the recents
          screenshot makes Android paint a solid colour rather than render the
          window background, and the colour it reaches for is this one — left
          unset it was AppCompat's dark grey, which is why the card looked
          like nobody's app.
        -->
        <item name="android:colorBackground">@color/contour_ground</item>
    </style>


    <!-- The launch window, shown until the WebView paints. Same drawable as
         the recents card, so the entrance and the card agree. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/contour_splash</item>
    </style>
</resources>