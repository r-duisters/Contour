<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
          This is the theme the activity runs under once launched, so this is
          the background Android substitutes for the recents card now that the
          card is no longer a photograph of the window. Without it the card is
          a flat rectangle.

          It sits behind an opaque WebView, so it costs nothing while the app
          is actually on screen.
        -->
        <item name="android:windowBackground">@drawable/contour_splash</item>
        <!--
          What the recents card is actually filled with. Disabling the recents
          screenshot makes Android paint a solid colour rather than render the
          window background, and the colour it reaches for is this one — left
          unset it was AppCompat's dark grey, which is why the card looked
          like nobody's app.
        -->
        <item name="android:colorBackground">@color/contour_ground</item>
    </style>


    <!--
      The launch window.

      `Theme.SplashScreen` does not read a window background. It composes the
      splash from these attributes, and with none of them set Android fell back
      to the launcher icon on its own ground — a squircle on a colour that is
      not this app's — one frame before the WebView drew the circular mark on
      `contour_ground`. Three pictures of the same mark in the first second,
      none of them agreeing.

      The names carry no `android:` prefix on purpose. `core-splashscreen`
      defines them itself and its `values-v31` theme forwards each to the
      platform attribute, so one declaration covers both the compat splash
      below API 31 and the real one above it.

      `postSplashScreenTheme` is what finally applies `AppTheme.NoActionBar`,
      and it only takes effect because `MainActivity` calls
      `installSplashScreen()`. Without both, that style — which is where the
      recents card's colour is set — was written for an activity that never
      wore it.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/contour_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/contour_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!--
          The window behind the compat splash view on API 30 and below, and the
          same drawable the recents card uses, so nothing flashes through.
        -->
        <item name="android:windowBackground">@drawable/contour_splash</item>
    </style>
</resources>