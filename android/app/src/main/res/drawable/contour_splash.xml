<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android draws when there is no app content to show: the launch window
  below API 31, and the recents card, which since
  `setRecentsScreenshotEnabled(false)` is substituted from the window
  background rather than photographed.

  This drawable is *not* what a phone on API 31 or above shows at launch.
  `Theme.SplashScreen` composes that from `windowSplashScreenBackground` and
  `windowSplashScreenAnimatedIcon`, and reads no window background at all — a
  fact that cost this app a square logo at every launch for months, because the
  disc drawn here was only ever reached below 31.

  The mark comes from `contour_splash_icon`. The size is declared here, on the
  item, or the vector would be stretched to the whole window — a disc the size
  of the screen on a recents card. `@dimen/splash_icon_box` is 188 rather than
  112 because that vector holds an invisible ground circle; the reasoning is
  written there.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/contour_ground" />

    <item
        android:width="@dimen/splash_icon_box"
        android:height="@dimen/splash_icon_box"
        android:gravity="center"
        android:drawable="@drawable/contour_splash_icon" />
</layer-list>
