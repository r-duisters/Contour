<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android draws when there is no app content to show: the launch window
  before the WebView's first paint, and the recents card, which since
  `setRecentsScreenshotEnabled(false)` is substituted from the window
  background rather than photographed.

  The disc is drawn here as a shape rather than borrowed from the launcher
  icon, and that is not a style preference. `@mipmap/ic_launcher_round`
  resolves to `mipmap-anydpi-v26/ic_launcher_round.xml` on API 26 and above,
  which is an `adaptive-icon` and not a bitmap; putting it inside `bitmap`
  compiles without complaint and then throws when the window background is
  inflated, which is at activity start. That crashed the app on launch.

  `@mipmap/ic_launcher_foreground` is safe under `bitmap` because it is a real
  PNG at every density and has no `anydpi` override to turn it into XML. It is
  the white mark on transparency, already inset for the adaptive icon's safe
  area, so it sits inside the disc without further padding.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/contour_ground" />

    <!--
      112dp is the unlock disc's diameter, so the launch window, the recents
      card and the lock screen all show the mark at the same size.
    -->
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>

    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_launcher_foreground"
            android:gravity="center" />
    </item>
</layer-list>
