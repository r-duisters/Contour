# Copy to `.env` beside this file and fill in. Docker Compose reads it
# automatically; `.gitignore` already covers it.

# Signs the session cookie. openssl rand -hex 32
SESSION_SECRET=

# Guards /api/cron/evaluate, the one route that acts without a session.
# openssl rand -hex 32
CRON_SECRET=

# Web Push, optional. npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Host port. The container always listens on 3000.
CONTOUR_PORT=3000

# For docker-compose.alerts.yml: where the scheduler should reach the app.
# With the web app in Docker too, the service name resolves on the shared
# network; from the host use http://host.docker.internal:3000
CONTOUR_URL=http://host.docker.internal:3000
INTERVAL_SECONDS=900
