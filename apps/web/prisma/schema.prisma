generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Alert {
  id            String       @id @default(cuid())
  kind          String       @default("indicator") // "indicator" | "price_target" | "pct_move"
  symbol        String? // null for portfolio-scoped alerts
  /// How to price this alert's symbol: "crypto" | "equity".
  ///
  /// Recorded rather than sniffed. A ticker cannot answer the question —
  /// `isEquityTicker` needs a dot, and AMD, NVDA and every other US listing
  /// have none, so they would be sent to Binance as AMDUSDT. That symbol may
  /// well exist and answer with an unrelated token's price, and firing on the
  /// wrong number is worse than not firing at all.
  assetType     String       @default("crypto")
  portfolioId   String? // pct_move only: evaluate every held symbol in this portfolio
  portfolio     Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  timeframe     String
  params        String       // JSON-encoded params for the kind
  enabled       Boolean      @default(true)
  lastEvaluated DateTime?
  lastBarTime   BigInt?      // ms timestamp of the last bar we evaluated
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        AlertEvent[]

  @@index([enabled])
}

model AlertEvent {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  barTime   BigInt
  signal    String   // e.g. "long" | "short" | "exit"
  price     Float
  payload   String   // JSON of full signal context
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([alertId, barTime, signal])
  @@index([alertId, createdAt])
}

model BacktestRun {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  fromTime  BigInt
  toTime    BigInt
  params    String   // JSON
  stats     String   // JSON: pnl, winRate, maxDrawdown, trades, ...
  createdAt DateTime @default(now())
}

model Portfolio {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  alerts       Alert[]
}

model Transaction {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String    // Binance pair (BTCUSDT) for crypto, exchange ticker (ASML.AS) for equities
  assetType   String    @default("crypto") // "crypto" | "equity" | "cash"
  side        String    // "buy" | "sell" | "transfer_in" | "transfer_out" | "income"
  quantity    Float
  price       Float     // quote units per base unit; for transfers this is the cost-basis price
  fee         Float     @default(0) // in quote units
  // What the trade actually cost in its own currency, so a EUR investor's cost
  // basis is not distorted by re-converting USD at today's rate.
  nativeCurrency String?
  nativePrice    Float?
  nativeFee      Float?
  /// The security an income row is attributed to — a Shell dividend is EUR
  /// credited against SHELL.AS, and the share count does not move. Null for
  /// income with no source (bank interest) and for every other side.
  sourceSymbol String?
  time        BigInt    // ms timestamp
  note        String?
  createdAt   DateTime  @default(now())

  @@index([portfolioId, time])
}

model WebAuthnCredential {
  id         String   @id // credential id, base64url
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports String? // JSON array of AuthenticatorTransport
  label      String?
  createdAt  DateTime @default(now())
}

model Settings {
  id              Int     @id @default(1)
  passwordHash    String?
  displayCurrency String  @default("USD") // any of core/currencies.ts DISPLAY_CURRENCIES
  equityProvider  String  @default("yahoo") // "yahoo" | "twelvedata" | "alphavantage"
  equityApiKey    String?
  haUrl           String?
  haWebhookId     String?
  mqttBrokerUrl   String?
  mqttTopicPrefix String?
}

/// A device registered for Firebase Cloud Messaging.
///
/// Separate from `PushSubscription` because the two are different mechanisms,
/// not two spellings of one. Web Push addresses a browser endpoint with a
/// keypair; FCM addresses a device through Google with an opaque token. The
/// APK can only use the second — Android's WebView implements no Push API —
/// and a browser installed as a PWA can only use the first.
model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  /// What registered it, for a person reading the table. Never used to route.
  label     String?
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
