DATABASE_URL="file:./dev.db"
SESSION_SECRET=""        # openssl rand -hex 32
CRON_SECRET=""           # openssl rand -hex 32
VAPID_PUBLIC_KEY=""      # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Firebase service account JSON, on one line, for sending FCM to the Android
# build. Firebase console -> Project settings -> Service accounts -> Generate
# new private key. Absent means the FCM notifier is simply not created, the
# same way absent VAPID keys skip Web Push.
FCM_SERVICE_ACCOUNT=''
