# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

**/src/generated/prisma

# SQLite (Prisma local dev DB)
**/prisma/dev.db
**/prisma/dev.db-journal

# Capacitor / Android build output
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
.icon-cache/

# Superdesign scratch: repo-analysis context and extracted site DNA are
# regenerable. The design system itself is a real document and stays tracked.
.superdesign/init/
.superdesign/website/
.superdesign/tmp/

# Parity baseline: captured route bodies, containing the owner's real holdings.
# Regenerate with `node scripts/parity.mjs capture .parity-baseline.json <path...>`.
.parity-baseline.json
