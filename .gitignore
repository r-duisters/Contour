# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template is the opposite of a secret: it names the variables and holds
# none of their values, and a compose file that fails without it is useless
# without something to copy.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

**/src/generated/prisma

# SQLite (Prisma local dev DB)
**/prisma/dev.db
**/prisma/dev.db-journal
# Dated copies taken before a migration. The bare name above does not match
# them, and one reached a merge commit before it was caught — this is a real
# ledger, not a fixture.
**/prisma/dev.db.*

# Capacitor / Android build output
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
.icon-cache/

# Superdesign scratch: repo-analysis context and extracted site DNA are
# regenerable. The design system itself is a real document and stays tracked.
.superdesign/init/
.superdesign/website/
.superdesign/tmp/

# Parity baselines: captured route bodies, containing the owner's real holdings.
# Regenerate with `node scripts/parity.mjs capture .parity-baseline.json <path...>`.
# A task that needs paths the phase baseline does not cover captures its own
# `.parity-<task>-*.json` rather than overwriting the shared one; the glob keeps
# those out of the repo too, holdings and all.
.parity-*.json

# Portfolio exports and backups. Real transaction history — prices, dates and
# amounts — which is the one thing this app exists to keep on your own
# hardware. backup-before-equity-repair-20260821.json was tracked until
# 2026-08-23 and remains in the history; this stops any new one joining it.
backup-*.json
*-backup.json

# Release signing. Never in the tree — see `contourSigning` in
# android/app/build.gradle, which reads from here or from the environment.
keystore.properties
*.jks
*.keystore
