generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Alert {
  id            String       @id @default(cuid())
  kind          String       @default("indicator") // "indicator" | "price_target" | "pct_move"
  symbol        String? // null for portfolio-scoped alerts
  portfolioId   String? // pct_move only: evaluate every held symbol in this portfolio
  portfolio     Portfolio?   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  timeframe     String
  params        String       // JSON-encoded params for the kind
  enabled       Boolean      @default(true)
  lastEvaluated DateTime?
  lastBarTime   BigInt?      // ms timestamp of the last bar we evaluated
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  events        AlertEvent[]

  @@index([enabled])
}

model AlertEvent {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  barTime   BigInt
  signal    String   // e.g. "long" | "short" | "exit"
  price     Float
  payload   String   // JSON of full signal context
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([alertId, barTime, signal])
  @@index([alertId, createdAt])
}

model BacktestRun {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  fromTime  BigInt
  toTime    BigInt
  params    String   // JSON
  stats     String   // JSON: pnl, winRate, maxDrawdown, trades, ...
  createdAt DateTime @default(now())
}

model Portfolio {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  alerts       Alert[]
}

model Transaction {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String    // Binance pair (BTCUSDT) for crypto, exchange ticker (ASML.AS) for equities
  assetType   String    @default("crypto") // "crypto" | "equity"
  side        String    // "buy" | "sell" | "transfer_in" | "transfer_out"
  quantity    Float
  price       Float     // quote units per base unit; for transfers this is the cost-basis price
  fee         Float     @default(0) // in quote units
  time        BigInt    // ms timestamp
  note        String?
  createdAt   DateTime  @default(now())

  @@index([portfolioId, time])
}

model WebAuthnCredential {
  id         String   @id // credential id, base64url
  publicKey  Bytes
  counter    BigInt   @default(0)
  transports String? // JSON array of AuthenticatorTransport
  label      String?
  createdAt  DateTime @default(now())
}

model Settings {
  id              Int     @id @default(1)
  passwordHash    String?
  displayCurrency String  @default("USD") // "USD" | "EUR"
  equityProvider  String  @default("yahoo") // "yahoo" | "twelvedata" | "alphavantage"
  equityApiKey    String?
  haUrl           String?
  haWebhookId     String?
  mqttBrokerUrl   String?
  mqttTopicPrefix String?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
