{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/core/*": ["./packages/core/src/*"],
      "@/ui/*": ["./packages/ui/src/*"],
      "@/lib/*": ["./packages/core/src/*"],
      "@/components/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "scripts/**/*.ts", "capacitor.config.ts", "**/*.mts"],
  "exclude": ["node_modules", "apps"]
}
